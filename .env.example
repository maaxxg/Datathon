# Copy to .env (git-ignored). No secrets here.
#
# Public domain name for HTTPS (Caddy gets a Let's Encrypt certificate automatically
# when DNS points to this machine and ports 80/443 are reachable).
# Leave empty to serve on https://localhost with Caddy's internal (self-signed) CA.
DOMAIN=

# Optional Ollama settings for natural-language JSON queries and report Q&A:
# Default inside Docker reaches Ollama on the host via host.docker.internal:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
