# DOMAIN unset  -> https://localhost with Caddy's internal CA (browser warning).
# DOMAIN=<name> -> public HTTPS with an automatic certificate.
{$DOMAIN:localhost} {
	encode gzip zstd

	# PRIVACY: there is deliberately NO `log` directive in this file. Without it Caddy
	# writes no access log, and request URIs contain lat/lon and address queries.
	# Do not add one.

	header {
		# OSM's tile policy needs a Referer, so send only our origin (domain, never
		# path or query) to other sites; the app never puts coordinates in the URL.
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Static SvelteKit build (SPA mode): unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
